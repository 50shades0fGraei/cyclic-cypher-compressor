# Step 1 — find the flash drive
lsblk

# Step 2 — mount it
sudo mkdir -p /mnt/usb
sudo mount /dev/sdb1 /mnt/usb

# Step 3 — copy files to your home folder
cp -r /mnt/usb ~/usb_files/

# Step 4 — save a list of all files to a text file
find /mnt/usb -print > ~/usb_contents.txt

# Step 5 — unmount when done
sudo umount /mnt/usb

To set a custom background image for LightDM:

```bash
# Step 1 — copy your image from the flash drive
sudo mkdir -p /mnt/usb
sudo mount /dev/sdb1 /mnt/usb

# Copy the image to the system
sudo cp /mnt/usb/yourimage.jpg /usr/share/pixmaps/cubix-bg.jpg

sudo umount /mnt/usb
```

```bash
# Step 2 — set it as the LightDM background
sudo nano /etc/lightdm/lightdm-gtk-greeter.conf
```

**Add/edit this in the file:**
```ini
[greeter]
background=/usr/share/pixmaps/cubix-bg.jpg
theme-name=Adwaita-dark
icon-theme-name=Adwaita
font-name=Cantarell 12
```

```bash
# Step 3 — restart LightDM to apply
sudo systemctl restart lightdm
```

